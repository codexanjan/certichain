# ==============================================================================
# CERTICHAIN ROOT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=5000

# PostgreSQL Database URL
# For local Docker: postgresql://certichain:certichain_secret_2026@localhost:5432/certichain_db?schema=public
# For zero-dependency dev fallback: file:./dev.db
DATABASE_URL=postgresql://certichain:certichain_secret_2026@localhost:5432/certichain_db?schema=public

# Database credentials (if launching via Docker Compose)
POSTGRES_USER=certichain
POSTGRES_PASSWORD=certichain_secret_2026
POSTGRES_DB=certichain_db
POSTGRES_PORT=5432

# Authentication Secrets (Generate secure 256-bit keys for production)
JWT_ACCESS_SECRET=certichain_jwt_super_access_secret_key_32_bytes_min_2026!
JWT_REFRESH_SECRET=certichain_jwt_super_refresh_secret_key_32_bytes_min_2026!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS and Allowed Origins
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Blockchain Network Configuration
BLOCKCHAIN_NETWORK=hardhat
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Default Hardhat Account #0 private key for local development:
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Deployed CertificateRegistry contract address (filled automatically after deployment):
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Storage Adapter Configuration
LOCAL_STORAGE_PATH=./storage/certificates
MAX_UPLOAD_SIZE_MB=10

# Frontend Environment Variables (Vite)
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
VITE_APP_URL=http://localhost:5173
VITE_BLOCKCHAIN_EXPLORER_URL=
